<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CyberManager.Server.Setup</RootNamespace>
    <AssemblyName>CyberManagerSetupTool</AssemblyName>
    <Version>3.3.0</Version>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Règle 3 : fonctionne avec .NET 8, 9 ou 10 installé sur la machine -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CyberManager.Server.Setup.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CyberManager.Server.Common\CyberManager.Server.Common.csproj" />
  </ItemGroup>

  <!-- Même environnement PHP que le service (une seule source de vérité, pas de copie) -->
  <ItemGroup>
    <Compile Include="..\CyberManager.Server.Host\EnvironnementPhp.cs" Link="Partages\EnvironnementPhp.cs" />
  </ItemGroup>

</Project>