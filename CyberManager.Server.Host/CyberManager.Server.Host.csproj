<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CyberManager.Server.Host</RootNamespace>
    <AssemblyName>CyberManagerServerService</AssemblyName>
    <Version>3.1.0</Version>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Règle 3 : fonctionne avec .NET 8, 9 ou 10 installé sur la machine -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <!-- Date de compilation embarquée : sert de plancher à la garde d'horloge (ClockGuard) -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildDateUtc</_Parameter1>
      <_Parameter2>$([System.DateTime]::UtcNow.ToString("o"))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CyberManager.Server.Common\CyberManager.Server.Common.csproj" />
  </ItemGroup>

</Project>